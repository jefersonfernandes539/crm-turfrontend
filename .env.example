# Copie para .env.local e preencha.

# --- Banco (Neon) -----------------------------------------------------
# Neon → seu projeto → Connection string (use a "Pooled connection")
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Sessão -----------------------------------------------------------
# Texto aleatório com 32+ caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Deixe "false" para que só o admin crie usuários (npm run user:create)
ALLOW_SIGNUP=false

# --- Arquivos (Cloudflare R2) -----------------------------------------
# Cloudflare → R2 → Manage API tokens → token com "Object Read & Write"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=turhost-files

# Opcional: domínio público do bucket (R2 → Settings → Public access),
# ex.: https://pub-xxxx.r2.dev — servir direto do R2 não gasta banda da app.
# Em branco, os arquivos são servidos por /api/storage/file/...
NEXT_PUBLIC_STORAGE_PUBLIC_URL=

# --- Só para migrar do Supabase (npm run storage:migrate) -------------
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
